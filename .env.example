# Terraform variables for local development that are NOT in committed tfvars.
# Copy to .env.<environment> (e.g. .env.dev) and fill in values.
# These files are gitignored — never commit them.
#
# Loaded automatically by ./terraw.sh (switch / plan / apply) for the selected env.
#
# In CI these move to GitHub Actions, scoped per GitHub Environment (dev/test/prod):
#   - the secret values below      -> GitHub Environment SECRETS
#   - the non-secret ops values    -> GitHub Environment VARIABLES
# The workflow re-exports each as TF_VAR_<name> before running Terraform.
#
# Do NOT add ARM_* service principal credentials here. Local auth uses `az login`;
# ARM_* is CI-only (injected via GitHub Actions secrets to authenticate the runner).
#
# NOTE: Key Vault secret references (*_kv_secret_id) are NOT here — they are
# non-secret pointers committed in environments/<env>/terraform.tfvars. The actual
# secret VALUES live in the per-env Key Vault (ismd-kv-<env>), seeded out-of-band via
# `az keyvault secret set` and pulled by each app's managed identity at runtime.

# --- Secrets: literals Terraform still consumes directly (Class B) -> GitHub Env SECRETS ---
# These are NOT set here any more. terraw reads them from ismd-kv-<env> into its own
# process on every plan/apply, per the name mapping in .terraw-vault-map — so they never
# land on disk. Setting one here still wins (a set value is left alone), which is the
# escape hatch for testing a value that is not in the vault yet.
#
#   TF_VAR_tool_postgres_password        <- postgres-password
#   TF_VAR_tool_keycloak_admin_password  <- keycloak-admin-password
#
# TEST only — site-preview bypass secret; still inline, not in Key Vault:
# TF_VAR_tool_site_preview_secret=

# --- Non-secret ops config -> GitHub Env VARIABLES ---
# Operator IP(s) allowed on the Postgres admin firewall rule, e.g. ["203.0.113.4"]
TF_VAR_admin_allowed_ips=
# Entra object id(s) granted data-plane secret access on the per-env Key Vault, e.g. ["<oid>"]
TF_VAR_keyvault_operator_object_ids=
# Alert recipients for paging-tier monitoring, e.g. ["ops@example.com"]
TF_VAR_paging_email_recipients=
# Teams notifier target (Phase A = maintainer test channel; Phase B = DIA channel)
TF_VAR_teams_group_id=
TF_VAR_teams_channel_id=
