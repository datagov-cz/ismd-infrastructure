# Sensitive Terraform variables for local development.
# Copy to .env.<environment> (e.g. .env.dev) and fill in values.
# These files are gitignored — never commit them.
#
# Load with: source load_env_vars.sh <env>
# This exports all variables below and switches the Terraform workspace.
#
# Note: do NOT add ARM_* service principal credentials here.
# Local authentication uses `az login`. ARM_* variables override CLI auth
# and are only intended for CI (injected via GitHub Actions secrets).

TF_VAR_tool_postgres_password=
TF_VAR_tool_postgres_user=
TF_VAR_tool_postgres_url=
TF_VAR_tool_nextauth_secret=
TF_VAR_tool_keycloak_admin_password=
TF_VAR_tool_keycloak_client_secret=
