# Docker Compose environment for the local dev stack.
# Copy to `.env` (auto-loaded by `docker compose`) and adjust as needed.

# --- Sibling repo paths (override if your local folder names differ) ---
# Defaults assume canonical ismd-* layout. Uncomment + adjust if you cloned
# the repos under shorter names (e.g. backend/, frontend/, tool-backend/, tool-frontend/).
# VALIDATOR_BACKEND_PATH=../backend
# TOOL_BACKEND_PATH=../tool-backend
# VALIDATOR_FRONTEND_PATH=../frontend
# TOOL_FRONTEND_PATH=../tool-frontend

# --- Backend images (when not building locally) ---
TOOL_BACKEND_IMAGE=ghcr.io/datagov-cz/ismd-tool-backend-dev:latest
TOOL_BACKEND_PULL_POLICY=missing

VALIDATOR_BACKEND_IMAGE=ghcr.io/datagov-cz/ismd-validator-backend-dev:latest
VALIDATOR_BACKEND_PULL_POLICY=missing

# --- Frontend images (only used with docker-compose.frontends.yml) ---
VALIDATOR_FRONTEND_IMAGE=ghcr.io/datagov-cz/ismd-validator-frontend-dev:latest
VALIDATOR_FRONTEND_PULL_POLICY=missing
TOOL_FRONTEND_IMAGE=ghcr.io/datagov-cz/ismd-tool-frontend-dev:latest
TOOL_FRONTEND_PULL_POLICY=missing

# --- Required only when using build overrides (Maven -> GitHub Packages) ---
# Generate at https://github.com/settings/tokens with `read:packages` scope.
GITHUB_TOKEN=
GITHUB_ACTOR=

# --- Tool backend - Keycloak client secret ---
# Must match your Keycloak realm config.
KEYCLOAK_CLIENT_SECRET=secret123

# --- Optional CAAIS IdP federation for Keycloak ---
CAAIS_CLIENT_ID=
