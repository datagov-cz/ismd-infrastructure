# DEV example. Secrets come from .env.<env> via TF_VAR_ (never in tfvars — these
# files are committed). The Keycloak admin password reuses the main state's
# TF_VAR_tool_keycloak_admin_password, already set in every .env.<env>.

keycloak_url = "https://oha03.dia.gov.cz"
app_base_url = "https://oha03.dia.gov.cz/popisujeme"
app_origin   = "https://oha03.dia.gov.cz"

# DEV-only: allow a local frontend to log in through deployed DEV Keycloak.
# Leave empty ([]) on TEST/PROD.
local_dev_origins = ["http://localhost:3000"]

# tool_keycloak_admin_user defaults to "admin"
# tool_keycloak_admin_password comes from TF_VAR_tool_keycloak_admin_password (.env.<env>)

# Registration / email — keep off until decided / SMTP live.
registration_allowed   = false
reset_password_allowed = false
verify_email           = false

# SMTP — flip on only after the supervisor delivers the ACS SMTP username/
# password (Layer A). Until then leave smtp_enabled = false.
smtp_enabled  = false
# smtp_from     = "DoNotReply@<guid>.azurecomm.net"
# smtp_username = "ismd-acs.<entra-app-id>.<tenant-id>"   # via TF_VAR_
# smtp_password = "..."                                    # via TF_VAR_
